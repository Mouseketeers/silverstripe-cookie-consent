{
  "name": "mouseketeers/silverstripe-cookie-consent",
  "description": "GDPR compliant cookie consent checker",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "Silverstripe",
    "GDPR",
    "Cookie",
    "Consent",
    "Privacy",
    "CMP"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Mouseketeers",
      "email": "support@mouseketeers.dk",
      "homepage": "https://www.mouseketeers.dk"
    }
  ],
  "require": {
    "silverstripe/framework": "^6",
    "silverstripe/cms": "^6",
    "silverstripe/admin": "^3",
    "silverstripe/siteconfig": "^6",
    "php": "^8.3"
  },
  "autoload": {
    "psr-4": {
      "Mouseketeers\\CookieConsent\\": "src/"
    }
  },
  "suggest": {
    "mouseketeers/silverstripe-consent-records": "For consent logging, run: composer require mouseketeers/silverstripe-consent-records ^1.0",
    "mouseketeers/silverstripe-consent-forms": "For consent forms, run: composer require mouseketeers/silverstripe-consent-forms ^1.0"
  },
  "extra": {
    "expose": [
      "client",
      "images"
    ]
  }
}

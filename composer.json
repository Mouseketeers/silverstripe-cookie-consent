{
  "name": "mouseketeers/silverstripe-cookie-consent",
  "description": "GDPR compliant cookie consent checker",
  "type": "silverstripe-vendormodule",
  "keywords": ["Silverstripe", "GDPR", "Cookie", "Consent", "Privacy", "CMP"],
  "license": "BSD-3-Clause",
    "authors": [
      {
          "name": "Mouseketeers",
          "email": "support@mouseketeers.dk",
          "homepage": "https://www.mouseketeers.dk"
      }
  ],
  "require": {
    "silverstripe/framework": "^4.0 || ^5.4",
    "silverstripe/cms": "^4.0 || ^5",
    "silverstripe/admin": "^1.0 || ^2",
    "silverstripe/siteconfig": "^4.0 || ^5",
    "php": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Mouseketeers\\CookieConsent\\": "src/"
    }
  },
  "suggest": {
    "mouseketeers/silverstripe-consent-records": "Stores cookie consent choices (enable_consent_logging). Needs 2.2+ on SilverStripe 4 or 4.1+ on SilverStripe 5."
  },
  "conflict": {
    "mouseketeers/silverstripe-consent-records": "<2.2 || >=3 <4.1"
  },
  "extra": {
    "expose": [
      "client"
    ]
  }
}

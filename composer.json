{
  "name": "mouseketeers/silverstripe-cookie-consent",
  "description": "GDPR compliant cookie consent checker",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "Silverstripe",
    "GDPR",
    "Cookie",
    "Consent",
    "Privacy",
    "CMP"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Mouseketeers",
      "email": "support@mouseketeers.dk",
      "homepage": "https://www.mouseketeers.dk"
    }
  ],
  "require": {
    "silverstripe/framework": "^6",
    "silverstripe/cms": "^6",
    "silverstripe/admin": "^3",
    "silverstripe/siteconfig": "^6",
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Mouseketeers\\CookieConsent\\": "src/"
    }
  },
  "suggest": {
    "mouseketeers/silverstripe-consent-records": "Stores cookie consent choices (enable_consent_logging). Needs ^4."
  },
  "conflict": {
    "mouseketeers/silverstripe-consent-records": "<4"
  },
  "extra": {
    "expose": [
      "client"
    ]
  }
}
